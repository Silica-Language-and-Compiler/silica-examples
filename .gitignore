# Build output written next to each example by `silica build` / `silica run`
# (also holds the FFI archives the CLI builds, e.g. libsilica_sockets.a)
.silica-build/

# Compiler artifacts, in case the compiler is ever run directly in an example folder
*.sams
*.iface
*.o
*.a
silica.config
silica.compile.*
silica.atoms
silica.shapes
silica.link
__silica_runtime.*

# Silica storage backings (generated, e.g. by ml-linear-regression/csv_to_sildat.py)
*.sildat

# Editors and OS
.DS_Store
.vscode/
.idea/
*.swp
*~

*__ignore*